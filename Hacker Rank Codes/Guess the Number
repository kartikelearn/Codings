import random
num = random.randint(1, 100)
print("Choose Difficulty")
print("1. Easy")
print("2. Medium")
print("3. Hard")

choice = int(input("Enter your choice: "))

if choice == 1:
    attempts = 10
    print("\nYou've 10 attempts.")
elif choice == 2:
    attempts = 7
    print("\nYou've 7 attempts.")
elif choice==3:
    attempts = 5
    print("\nYou've 5 attempts.")
else:
    print("Invalid Choice")
    exit()

#won=False

for i in range(1, attempts+1):
    if i == attempts:
        print("\n\nWarning! This is your last attempt.\n")

    print(f"\nAttempt {i}/{attempts}")

    n = int(input("Enter a random num b/w 1-100: "))

    if n == num:
        print("\nCongratulations! You guessed the correct number.")
        print(f"You won in {i} attempts.")
       # won=True
        break
    elif n < num:
        if n >= num - 5:
            print("Low! But You are Close!")
        else:
            print("Too Low!")
    else:
        if n <= num + 5:
            print("High! But You are Close!")
        else:
            print("Too High!")
#if not won... if
#for ... else → the else runs only if the loop finishes normally, without encountering break.
else:
    print("\nYou Lost!")
    print(f"The correct number was {num}.")


print("Game Over!")